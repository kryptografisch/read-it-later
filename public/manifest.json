{
  "name": "read-it-later PWA",
  "short_name": "read-it-later PWA",
  "description": "Read It Later! A progressive web app to store web links for later use.",
  "display": "standalone",
  "start_url": "/",
  "scope": "/",
  "theme_color": "#000",
  "background_color": "#000",
  "icons": [
    {
      "src": "images/android-chrome-192x192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "images/android-chrome-512x512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "images/maskable_icon.png",
      "sizes": "1024x1024",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "share_target": {
    "action": "/",
    "method": "GET",
    "enctype": "application/x-www-form-urlencoded",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  }
}
